{
  "name": "@moncha/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "db:seed": "node ./scripts/guarded.cjs tsx prisma/seed.ts",
    "db:reset": "node ./scripts/guarded.cjs prisma migrate reset --force",
    "db:migrate": "node ./scripts/guarded.cjs prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:validate": "node ./scripts/validate.mjs"
  },
  "dependencies": {
    "@moncha/domain": "workspace:*",
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "@moncha/config": "workspace:*",
    "@types/node": "^24.3.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
