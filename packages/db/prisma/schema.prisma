generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operator
  viewer
}

enum WebsiteStatus {
  /// Default until the first audit finishes.
  UNCHECKED
  ACTIVE
  INACTIVE
  PARKED
  INACCESSIBLE
  MISSING
}

enum AssistantVerdict {
  NO_ASSISTANT
  HAS_ASSISTANT
  UNCERTAIN
  NOT_APPLICABLE
}

enum AssistantKind {
  AI_CHATBOT
  LIVE_CHAT
  MESSAGING_LINK
  NONE
}

enum LeadQueue {
  PENDING_AUDIT
  QUALIFIED
  HAS_ASSISTANT
  NO_WEBSITE
  NEEDS_REVIEW
  INACTIVE
}

enum JobStatus {
  pending
  running
  done
  failed
}

enum JobType {
  places_discovery
  csv_import
  website_audit
  /// Country-wide crawl slice (worker): scheduled or started from the discover CLI.
  country_discovery
  /// Website copy of one lead's homepage (worker), stored in R2.
  site_snapshot
}

enum AuditMethod {
  html
  render
  llm
}

enum EvidenceType {
  script_src
  iframe_src
  dom_selector
  network_request
  window_global
  screenshot
  page_excerpt
  llm_reason
}

enum ChannelType {
  whatsapp
  messenger
  telegram
  line
  viber
  contact_form
  booking_link
  tel
  email
}

enum ReviewTaskStatus {
  open
  resolved
}

enum DiscoveryTargetStatus {
  pending
  done
  failed
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  users            User[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  companies        Company[]
  leads            Lead[]
  jobs             JobRun[]
  websites         Website[]
  sourceRecords    SourceRecord[]
  websiteAudits    WebsiteAudit[]
  evidenceItems    EvidenceItem[]
  detectedChannels DetectedChannel[]
  reviewTasks      ReviewTask[]
  auditLogs        AuditLog[]
  hostAuditCaches  HostAuditCache[]
  llmResultCaches  LlmResultCache[]
  llmUsages        LlmUsage[]
  discoveryTargets   DiscoveryTarget[]
  discoveryUsages    DiscoveryUsage[]
  discoverySchedules DiscoverySchedule[]
  siteSnapshots      SiteSnapshot[]
  siteAutomation     SiteAutomationSettings?
  siteAutomationCrawls SiteAutomationCrawl[]
  leadBots           LeadBot[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  name         String?
  role         UserRole  @default(operator)
  /// pbkdf2_sha256$<iterations>$<salt>$<hash>. Null = no password login.
  passwordHash String?
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
}

/// One-time forgot-password link. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bearer-token login session. Only the SHA-256 of the token is stored.
model Session {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  domain        String?
  country       String?
  city          String?
  phone         String?
  /// Primary contact email from the company's website (filled when a website copy extracts brand.contact.emails).
  email         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]
  sourceRecords SourceRecord[]
  website       Website?

  @@unique([tenantId, domain])
  @@index([tenantId, name])
  @@index([tenantId, country])
  @@index([tenantId, city])
  @@index([tenantId, createdAt])
}

model Lead {
  id                  String            @id @default(cuid())
  tenantId            String
  companyId           String
  queue               LeadQueue         @default(PENDING_AUDIT)
  /// Null until the first audit finishes (no PENDING enum — absence means unaudited).
  assistantVerdict    AssistantVerdict?
  assistantVendor     String?
  qualificationReason String?
  /// Lead-facing pointer to the audit that last set queue/verdict. Written in the same
  /// transaction as Website.latestAuditId (same audit id). See Website.latestAuditId.
  latestAuditId       String?
  /// MonCha demo bot for this lead (mirrors LeadBot.status): null = none, pending, creating, created or failed.
  botStatus           String?
  botCreatedAt        DateTime?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bot                 LeadBot?
  latestAudit         WebsiteAudit?     @relation("LeadLatestAudit", fields: [latestAuditId], references: [id], onDelete: SetNull)
  websiteAudits       WebsiteAudit[]    @relation("LeadAudits")
  reviewTasks         ReviewTask[]
  auditLogs           AuditLog[]
  siteSnapshots       SiteSnapshot[]
  jobs                JobRun[]

  @@unique([tenantId, companyId])
  @@index([tenantId, queue])
  @@index([tenantId, assistantVerdict])
  @@index([tenantId, assistantVendor])
  @@index([tenantId, createdAt])
}

model SourceRecord {
  id         String   @id @default(cuid())
  tenantId   String
  companyId  String
  source     String
  externalId String?
  rawJson    Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalId])
}

model Website {
  id            String        @id @default(cuid())
  tenantId      String
  companyId     String        @unique
  url           String
  canonicalUrl  String?
  status        WebsiteStatus @default(UNCHECKED)
  language      String?
  finalUrl      String?
  httpStatus    Int?
  title         String?
  /// Source of truth for "latest audit of this website URL". Lead.latestAuditId is the
  /// lead-facing pointer and must be set to the same audit id in the same transaction.
  latestAuditId String?
  lastCheckedAt DateTime?
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  latestAudit   WebsiteAudit? @relation("WebsiteLatestAudit", fields: [latestAuditId], references: [id], onDelete: SetNull)
  audits        WebsiteAudit[] @relation("WebsiteAudits")

  @@index([tenantId, status])
}

/// Immutable insert-only. Migration adds a trigger blocking UPDATE and DELETE.
/// Repositories expose create and read only.
model WebsiteAudit {
  id                  String            @id @default(cuid())
  tenantId            String
  websiteId           String
  leadId              String
  /// Highest-signal pass that produced the stored verdict (html | render | llm).
  method              AuditMethod
  /// True when the Playwright render pass actually ran (even if verdict came from html/llm).
  renderRan           Boolean           @default(false)
  /// True when the OpenRouter Pass 3 call actually ran.
  llmRan              Boolean           @default(false)
  verdict             AssistantVerdict
  kind                AssistantKind     @default(NONE)
  vendor              String?
  confidence          Float
  classifierVersion   String
  contentHash         String?
  failureReason       String?
  httpStatus          Int?
  finalUrl            String?
  llmModel            String?
  llmPromptVersion    String?
  llmResult           Json?
  llmPromptTokens     Int?
  llmCompletionTokens Int?
  /// USD OpenRouter charged for the Pass 3 call; null when it did not report one (estimated from tokens).
  llmCostUsd          Float?
  auditedAt           DateTime          @default(now())
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  website             Website           @relation("WebsiteAudits", fields: [websiteId], references: [id], onDelete: Cascade)
  lead                Lead              @relation("LeadAudits", fields: [leadId], references: [id], onDelete: Cascade)
  latestForLeads      Lead[]            @relation("LeadLatestAudit")
  latestForWebsites   Website[]         @relation("WebsiteLatestAudit")
  evidenceItems       EvidenceItem[]
  detectedChannels    DetectedChannel[]
  reviewTasks         ReviewTask[]
  jobs                JobRun[]

  @@index([tenantId, leadId, auditedAt])
  @@index([tenantId, websiteId, auditedAt])
  @@index([tenantId, method])
  @@index([tenantId, vendor])
}

/// Immutable insert-only. Migration adds a trigger blocking UPDATE and DELETE.
model EvidenceItem {
  id          String       @id @default(cuid())
  tenantId    String
  auditId     String
  type        EvidenceType
  url         String?
  selector    String?
  excerpt     String?
  vendor      String?
  sourcePage  String?
  objectUri   String?
  contentHash String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audit       WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([tenantId, auditId])
}

model DetectedChannel {
  id         String       @id @default(cuid())
  tenantId   String
  auditId    String
  type       ChannelType
  url        String
  selector   String?
  sourcePage String?
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audit      WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([tenantId, auditId])
}

model ReviewTask {
  id             String           @id @default(cuid())
  tenantId       String
  leadId         String
  auditId        String
  reason         String
  status         ReviewTaskStatus @default(open)
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  audit          WebsiteAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)

  /// Migration adds partial unique: one open task per lead
  /// CREATE UNIQUE INDEX review_task_one_open_per_lead ON "ReviewTask" ("tenantId", "leadId") WHERE status = 'open';
  @@index([tenantId, status])
  @@index([tenantId, leadId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  leadId     String?
  entityType String
  entityId   String
  action     String
  actorId    String?
  note       String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, leadId])
}

model JobRun {
  id          String    @id @default(cuid())
  tenantId    String
  type        JobType
  status      JobStatus @default(pending)
  payload     Json?
  result      Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  /// Set only when dedupe is wanted (e.g. website-audit). NULL allowed many times per tenant.
  dedupeKey   String?
  /// Lead the job works on (website_audit, site_snapshot). Mirrors payload.leadId.
  leadId      String?
  /// country_discovery job that queued this one. Mirrors payload.crawlJobId.
  crawlJobId  String?
  /// Audit a website_audit job produced or reused. Mirrors result.auditId.
  auditId     String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  crawlJob    JobRun?       @relation("CrawlChildJobs", fields: [crawlJobId], references: [id], onDelete: SetNull)
  crawlChildJobs JobRun[]   @relation("CrawlChildJobs")
  audit       WebsiteAudit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  siteSnapshot        SiteSnapshot?        @relation("SiteSnapshotJob")
  crawlSiteSnapshots  SiteSnapshot[]       @relation("SiteSnapshotCrawlJob")
  siteAutomationCrawl SiteAutomationCrawl?

  @@unique([tenantId, dedupeKey])
  @@index([status, runAfter])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([status, lockedAt])
  @@index([tenantId, leadId, type, status])
  @@index([tenantId, crawlJobId])
  @@index([auditId])
}

/// Intentionally not tenant-scoped: one row per worker process for liveness only.
model WorkerHeartbeat {
  workerId  String   @id
  hostname  String?
  updatedAt DateTime @updatedAt
}

/// Host-level audit cache. Key includes tenant + host + classifierVersion.
model HostAuditCache {
  id                String   @id @default(cuid())
  tenantId          String
  host              String
  classifierVersion String
  resultJson        Json
  auditedAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, host, classifierVersion])
  @@index([tenantId, auditedAt])
}

/// Pass-3 LLM response cache.
model LlmResultCache {
  id            String   @id @default(cuid())
  tenantId      String
  bundleHash    String
  model         String
  promptVersion String
  resultJson    Json
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bundleHash, model, promptVersion])
}

/// Source of truth for LLM_MAX_CALLS_PER_DAY. Failed and timed-out calls count.
model LlmUsage {
  id          String   @id @default(cuid())
  tenantId    String
  /// UTC calendar day as YYYY-MM-DD.
  day         String
  calls       Int      @default(0)
  failedCalls Int      @default(0)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, day])
}

/// One country-crawl search (city × keyword) and its progress, so crawls resume across runs.
model DiscoveryTarget {
  id          String                @id @default(cuid())
  tenantId    String
  source      String
  /// ISO 3166-1 alpha-2, e.g. SG, MY, JP.
  countryCode String
  city        String
  keyword     String
  /// Plan order: largest city first.
  rank        Int                   @default(0)
  status      DiscoveryTargetStatus @default(pending)
  attempts    Int                   @default(0)
  calls       Int                   @default(0)
  found       Int                   @default(0)
  created     Int                   @default(0)
  lastError   String?
  lastRunAt   DateTime?
  createdAt   DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, countryCode, city, keyword])
  @@index([tenantId, source, countryCode, status, rank])
}

/// Source of truth for DISCOVERY_MAX_CALLS_PER_DAY. Counts every provider HTTP request.
model DiscoveryUsage {
  id       String @id @default(cuid())
  tenantId String
  source   String
  /// UTC calendar day as YYYY-MM-DD.
  day      String
  calls    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, day])
}

/// Daily country crawl at a local wall-clock time. Each run is a country_discovery JobRun.
model DiscoverySchedule {
  id          String    @id @default(cuid())
  tenantId    String
  /// ISO 3166-1 alpha-2, e.g. SG, MY, JP.
  countryCode String
  /// 24h local time "HH:mm" in `timezone`.
  timeOfDay   String
  /// IANA zone, e.g. Asia/Kuala_Lumpur.
  timezone    String
  enabled     Boolean   @default(true)
  /// Next slot in UTC; the scheduler picks rows where nextRunAt <= now.
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode, timeOfDay])
  @@index([enabled, nextRunAt])
  @@index([tenantId, countryCode])
}

/// Website copy of one lead's homepage. Files live in R2 under storagePrefix; the row tracks
/// progress, counts and the extracted brand. Updated by the site_snapshot job while it runs.
model SiteSnapshot {
  id                  String    @id @default(cuid())
  tenantId            String
  leadId              String
  jobId               String?   @unique
  status              JobStatus @default(pending)
  sourceUrl           String
  finalUrl            String?
  httpStatus          Int?
  /// sites/{tenantId}/{id}/
  storagePrefix       String
  /// SHA-256 hex of source.html bytes.
  sourceHash          String?
  sourceBytes         Int?
  sourceCharset       String?
  assetCount          Int       @default(0)
  skippedAssetCount   Int       @default(0)
  totalBytes          Int       @default(0)
  brand               Json?
  llmModel            String?
  llmPromptTokens     Int?
  llmCompletionTokens Int?
  /// USD OpenRouter charged for brand extraction across all attempts; null = estimate from tokens.
  llmCostUsd          Float?
  /// Non-fatal notes, e.g. llm_skipped:budget_exhausted, base_href_neutralized.
  warnings            Json?
  failureReason       String?
  /// The error message behind failureReason, e.g. "getaddrinfo ENOTFOUND example.com".
  failureDetail       String?
  /// Copy attempts made so far (the job retries up to SITE_SNAPSHOT_MAX_ATTEMPTS).
  attempts            Int       @default(0)
  /// manual = started from the console; auto = queued by the copy automation after a crawl.
  origin              SiteCopyOrigin @default(manual)
  /// country_discovery job that found the lead (automatic copies only).
  crawlJobId          String?
  /// GitHub push of the code files: null (not pushed), pending, pushing, pushed or failed (gave up).
  githubStatus        String?
  githubAttempts      Int       @default(0)
  /// Earliest time the worker may (re)try the push.
  githubNextAt        DateTime?
  githubLockedAt      DateTime?
  githubCommitSha     String?
  githubCommitUrl     String?
  githubFolderUrl     String?
  githubError         String?
  githubPushedAt      DateTime?
  /// owner/name of the copy's own GitHub repo (one website, one repo).
  githubRepo          String?
  /// Cloudflare Worker deploy: null (not deployed), pending, deploying, deployed or failed (gave up).
  workerStatus        String?
  workerAttempts      Int       @default(0)
  /// Earliest time the worker may (re)try the deploy.
  workerNextAt        DateTime?
  workerLockedAt      DateTime?
  /// Worker script name, the same as the repo name (e.g. ja-edu-sg).
  workerName          String?
  /// https://{workerName}.{subdomain}.workers.dev
  workerUrl           String?
  workerError         String?
  workerDeployedAt    DateTime?
  /// MonCha chatbot added to index.html before the GitHub push: null (not added), pending, installing, installed or
  /// failed (gave up). Widget colour (5.1/5.2) and install values (6.3) are on the lead's LeadBot.
  chatbotStatus       String?
  chatbotAttempts     Int       @default(0)
  /// Earliest time the worker may (re)try adding the chatbot.
  chatbotNextAt       DateTime?
  chatbotLockedAt     DateTime?
  chatbotError        String?
  chatbotInstalledAt  DateTime?
  /// Copy job step while it runs (and the step it failed in): copying, reading_source or building.
  stage               String?
  stageAt             DateTime?
  createdAt           DateTime  @default(now())
  finishedAt          DateTime?
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  job                 JobRun?   @relation("SiteSnapshotJob", fields: [jobId], references: [id], onDelete: SetNull)
  crawlJob            JobRun?   @relation("SiteSnapshotCrawlJob", fields: [crawlJobId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, origin, createdAt])
  @@index([crawlJobId])
  @@index([githubStatus, githubNextAt])
  @@index([workerStatus, workerNextAt])
  @@index([chatbotStatus, chatbotNextAt])
}

enum SiteCopyOrigin {
  manual
  auto
}

/// One MonCha demo bot per lead, created through the internal lead API (POST /bots) before its website is copied.
model LeadBot {
  id             String    @id @default(cuid())
  tenantId       String
  leadId         String    @unique
  /// The website copy that was waiting for this bot, if any.
  siteSnapshotId String?
  /// uat, production or custom: the MonCha environment the bot lives in.
  environment    String
  /// pending, creating, created or failed (gave up after its tries).
  status         String    @default("pending")
  /// Name, tier and key of the create request. Saved before sending; retries send exactly the same request.
  name           String?
  planTier       String?
  idempotencyKey String?
  attempts       Int       @default(0)
  nextAt         DateTime?
  lockedAt       DateTime?
  /// Last error, `code: message`.
  error          String?
  /// data.bot_id (= install.chatbotId).
  chatbotId      String?
  /// data.customer_tenant_id (= install.tenantId): the MonCha enterprise workspace, not our tenant.
  monchaTenantId String?
  connectionId   String?
  /// The entire POST /bots response.
  config         Json?
  createdBotAt   DateTime?
  /// Website training once the bot is created: pending, discovering (discover + ingest-bulk running), training
  /// (submitted, polled until done), trained or failed (gave up after its tries). The website copy waits for trained.
  knowledgeStatus     String    @default("pending")
  knowledgeAttempts   Int       @default(0)
  knowledgeNextAt     DateTime?
  knowledgeLockedAt   DateTime?
  /// The lead's website URL that was discovered.
  websiteUrl          String?
  /// `urls` of POST knowledge/discover.
  discoveredUrls      Json?
  pagesFetched        Int?
  discoveryTruncated  Boolean?
  discoveredAt        DateTime?
  /// Key and body of POST knowledge/ingest-bulk. Saved before sending; retries send exactly the same request.
  trainingKey         String?
  trainingPayload     Json?
  trainingId          String?
  /// The latest GET training/:trainingId response.
  trainingResult      Json?
  trainingSubmittedAt DateTime?
  trainedAt           DateTime?
  /// Widget primaryColor picked from the website's brand colours and saved with PUT widget (5.2).
  widgetPrimaryColor  String?
  /// GET widget (5.1) response before the change, and the PUT widget (5.2) response after it.
  widgetConfigBefore  Json?
  widgetConfig        Json?
  /// GET install (6.3) response: tenantId, chatbotId, apiUrl, widgetUrl.
  installValues       Json?
  widgetConfiguredAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, nextAt])
  @@index([status, knowledgeStatus, knowledgeNextAt])
}

/// Worker-wide operator settings (one row). Pause drains the queue: in-flight work finishes, new work does not start.
/// Country discovery schedules keep running.
model WorkerSettings {
  id        String    @id @default("default")
  /// When true, bots, website copies and publish steps do not start new work; current items finish.
  queuePaused Boolean @default(false)
  pausedAt  DateTime?
  pausedBy  String?
  updatedAt DateTime  @updatedAt
}

/// Per-tenant switch and daily cap for automatic website copies.
model SiteAutomationSettings {
  tenantId  String    @id
  enabled   Boolean   @default(false)
  /// Automatic copies per UTC day. Manual copies never count.
  dailyCap  Int       @default(20)
  /// Only crawls that finish after this moment are swept, so turning automation on never floods old crawls.
  enabledAt DateTime?
  updatedBy String?
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Copy automation progress for one finished country crawl.
model SiteAutomationCrawl {
  /// The country_discovery JobRun id.
  crawlJobId      String    @id
  tenantId        String
  /// waiting_audits | queuing | complete
  status          String    @default("waiting_audits")
  auditsTotal     Int       @default(0)
  auditsPending   Int       @default(0)
  /// Qualified leads from this crawl that had no copy when the sweep looked.
  qualified       Int       @default(0)
  queued          Int       @default(0)
  /// Qualified leads still waiting for daily allowance.
  carriedOver     Int       @default(0)
  crawlFinishedAt DateTime
  lastCheckedAt   DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crawlJob        JobRun    @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, crawlFinishedAt])
  @@index([tenantId, crawlFinishedAt])
}
