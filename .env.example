# =============================================================================
# MonCha Lead Engine — environment template
# Copy to `.env` at the repo root. Never commit real secrets.
# Console loads this root file (see apps/console/next.config.ts).
# packages/db/.env is DB-only (Neon URLs + guard vars) for Prisma CLI.
# =============================================================================

# --- Required: Neon (use the DEV branch, not production) ---
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Required: DB safety guard (reset/seed refuse without these) ---
DB_ENV="dev"
PROD_DB_HOST="ep-lucky-violet-b5u7kp15"
NEON_BRANCH="dev"

# --- Required: console auth / app ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string"
DEFAULT_TENANT_ID="tenant_moncha_internal"

# --- Required: Google Places discovery (Discover page) ---
GOOGLE_PLACES_API_KEY=""

# --- Optional: other discovery providers ---
YELP_API_KEY=""
FOURSQUARE_API_KEY=""
SEARCH_API_KEY=""
SEARCH_ENGINE_ID=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- Required for Pass 3 LLM (website audit when ambiguous) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_TIMEOUT_MS="15000"
LLM_MAX_CALLS_PER_DAY="200"

# --- Worker (Postgres job poller) ---
WORKER_CONCURRENCY="3"
# Optional: force Playwright to use system browser (chrome | msedge) if bundled Chromium isn't installed
# PLAYWRIGHT_CHANNEL="msedge"
# Local evidence snapshots (screenshots + rendered DOM)
# EVIDENCE_DIR=".data/evidence"

# --- Product flag (senior review) ---
# false = show/fetch all websites (including chatbot sites)
# true  = omit HAS_ASSISTANT; Leads/API only surface sites without chatbots
OMIT_CHATBOT_SITES="false"
