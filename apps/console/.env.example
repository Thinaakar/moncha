# Console (frontend) environment. Copy to apps/console/.env.local for local dev.
# All values are server-only: the browser never sees them.

# Backend API base URL (no trailing slash).
# Local: the worker API (pnpm --filter @moncha/worker api) or poller with PORT set.
# Railway: the backend's private address, e.g. http://backend.railway.internal:8080
BACKEND_URL=http://127.0.0.1:4000

# Tenant the console signs users into (matches the backend's DEFAULT_TENANT_ID).
TENANT_ID=tenant_moncha_internal

# Only if the backend sets WORKER_API_KEY.
WORKER_API_KEY=
