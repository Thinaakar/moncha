{
  "info": {
    "name": "Moncha backend (worker test API)",
    "description": "Start the API with `pnpm --filter @moncha/worker api` (http://127.0.0.1:4000). Start the worker with `pnpm --filter @moncha/worker start` so queued crawls, schedules and audits actually run. Create requests save their ids into collection variables for the follow-up requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4000" },
    { "key": "tenantId", "value": "tenant_moncha_internal" },
    { "key": "apiKey", "value": "" },
    { "key": "scheduleId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "leadId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "authToken", "value": "" },
    { "key": "snapshotId", "value": "" },
    { "key": "previewBase", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'x-tenant-id', value: pm.collectionVariables.get('tenantId') });",
          "const key = pm.collectionVariables.get('apiKey');",
          "if (key) pm.request.headers.upsert({ key: 'x-api-key', value: key });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Save schedule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/schedules",
            "body": { "mode": "raw", "raw": "{\n  \"country\": \"Malaysia\",\n  \"time\": \"10:00\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created (201)', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('scheduleId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save schedule (Japan, Tokyo time)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/schedules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Japan\",\n  \"time\": \"09:30\",\n  \"timezone\": \"Asia/Tokyo\"\n}"
            }
          }
        },
        {
          "name": "Save schedule - invalid time (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/schedules",
            "body": { "mode": "raw", "raw": "{\n  \"country\": \"Malaysia\",\n  \"time\": \"25:00\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('rejected (400)', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "List schedules (grouped by country)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/schedules" }
        },
        {
          "name": "Run history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedules/runs?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "schedules", "runs"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Delete one time",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/schedules/{{scheduleId}}" }
        },
        {
          "name": "Delete country",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedules?country=Malaysia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "schedules"],
              "query": [{ "key": "country", "value": "Malaysia" }]
            }
          }
        }
      ]
    },
    {
      "name": "Discovery",
      "item": [
        {
          "name": "Start country crawl now (small)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/discovery/country",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Singapore\",\n  \"maxSearches\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queued (202)', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) pm.collectionVariables.set('jobId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Job status",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}" }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List qualified leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/leads?queue=QUALIFIED&page=1&pageSize=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leads"],
              "query": [
                { "key": "queue", "value": "QUALIFIED" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "country", "value": "Singapore", "disabled": true },
                { "key": "search", "value": "clinic", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().items?.[0];",
                  "if (first) pm.collectionVariables.set('leadId', first.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Queue counts",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/counts" }
        },
        {
          "name": "Get lead",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}" }
        },
        {
          "name": "Add lead manually",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/leads",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Dental\",\n  \"domain\": \"example.com\",\n  \"country\": \"Singapore\",\n  \"city\": \"Bedok\"\n}"
            }
          }
        },
        {
          "name": "Re-audit lead website",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/audit" }
        }
      ]
    },
    {
      "name": "Reviews",
      "description": "NEEDS_REVIEW leads. Set authToken (from login) to record who resolved the task; leave it empty to resolve as \"api\". Each task can be resolved once, so run List open reviews again before the next resolve.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('authToken');",
              "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "List open reviews",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews?status=open&page=1&pageSize=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews"],
              "query": [
                { "key": "status", "value": "open" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "country", "value": "Singapore", "disabled": true },
                { "key": "search", "value": "clinic", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().items?.[0];",
                  "if (first) pm.collectionVariables.set('reviewId', first.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolved review history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/reviews?status=resolved",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reviews"],
              "query": [{ "key": "status", "value": "resolved" }]
            }
          }
        },
        {
          "name": "Get review",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}" }
        },
        {
          "name": "Resolve - confirm no assistant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"confirm_no_assistant\",\n  \"note\": \"Checked the site, no chat widget\"\n}"
            }
          }
        },
        {
          "name": "Resolve - mark has assistant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"mark_has_assistant\",\n  \"note\": \"Tidio bubble bottom right\",\n  \"vendor\": \"tidio\"\n}"
            }
          }
        },
        {
          "name": "Resolve - request re-audit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"request_reaudit\",\n  \"note\": \"Site was down during the audit\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Website copies",
      "description": "Website Copy Agent. Needs R2_* and SITE_PREVIEW_SECRET in apps/worker/.env (otherwise 503 site_agent_not_configured). Creating a copy needs authToken from login (admin or operator). Run the worker so the site_snapshot job runs, then poll Get website copy until status is done.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('authToken');",
              "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Copy lead website",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/site-snapshots" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202 or 200 (deduped)', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "const body = pm.response.json();",
                  "if (body.snapshotId) pm.collectionVariables.set('snapshotId', body.snapshotId);",
                  "if (body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Website copies of lead",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/site-snapshots" }
        },
        {
          "name": "List website copies",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/site-snapshots?page=1&pageSize=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "site-snapshots"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "25" },
                { "key": "status", "value": "done", "disabled": true },
                { "key": "search", "value": "clinic", "disabled": true },
                { "key": "origin", "value": "auto", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Copy queue",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-snapshots/queue" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has running and waiting', () => { pm.expect(body.running).to.be.an('array'); pm.expect(body.waiting).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel waiting copy",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}/cancel" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('cancelled, or 409 when already started', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"]
              }
            }
          ]
        },
        {
          "name": "Add chatbot to website copy",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}/chatbot" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queued, or 404/409/503 when not possible', () => pm.expect(pm.response.code).to.be.oneOf([202, 404, 409, 503]));",
                  "if (pm.response.code === 202) pm.test('queued', () => pm.expect(pm.response.json().queued).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Push copy to GitHub",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}/github-push" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('queued, or 409/503 when not possible', () => pm.expect(pm.response.code).to.be.oneOf([202, 409, 503]));"]
              }
            }
          ]
        },
        {
          "name": "Deploy copy to its Cloudflare Worker",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}/deploy" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('queued, or 409/503 when not possible', () => pm.expect(pm.response.code).to.be.oneOf([202, 409, 503]));"]
              }
            }
          ]
        },
        {
          "name": "GitHub connection check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-automation/github-check" }
        },
        {
          "name": "Cloudflare Workers connection check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-automation/deploy-check" }
        },
        {
          "name": "MonCha internal lead API check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-automation/moncha-check" }
        },
        {
          "name": "Queue pause state",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/queue" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has paused flag', () => { const b = pm.response.json(); pm.expect(b).to.have.property('paused'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pause the queue",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"paused\": true\n}" },
            "url": "{{baseUrl}}/api/v1/queue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('paused', () => pm.expect(pm.response.json().paused).to.eql(true));"]
              }
            }
          ]
        },
        {
          "name": "Resume the queue",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"paused\": false\n}" },
            "url": "{{baseUrl}}/api/v1/queue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('resumed', () => pm.expect(pm.response.json().paused).to.eql(false));"]
              }
            }
          ]
        },
        {
          "name": "Copy automation settings",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-automation" }
        },
        {
          "name": "Turn copy automation on",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"enabled\": true\n}" },
            "url": "{{baseUrl}}/api/v1/site-automation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('enabled', () => pm.expect(pm.response.json().enabled).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crawls followed by automation",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-automation/crawls?limit=20" }
        },
        {
          "name": "Get website copy",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.previewBase) pm.collectionVariables.set('previewBase', body.previewBase);"
                ]
              }
            }
          ]
        },
        {
          "name": "View source (decoded)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/site-snapshots/{{snapshotId}}/source" }
        },
        {
          "name": "File - index.html (offline copy)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/{{previewBase}}index.html" }
        },
        {
          "name": "File - source.html download",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/{{previewBase}}source.html?download=1" }
        },
        {
          "name": "File - path traversal (expect 400)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/{{previewBase}}%2e%2e/secret" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 403, 404]));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lead bots",
      "description": "MonCha demo bot per lead (internal-lead-agent.md sections 3 and 7), created and trained before the lead's website is copied: GET /slots, tier with the most free slots, POST /bots with the company name and language en; then knowledge/discover (url, max_pages 100), knowledge/ingest-bulk (title, url, source_type per page) and the training status until completed. Needs MONCHA_INTERNAL_KEY in apps/worker/.env (otherwise 503 moncha_not_configured). Create and retry need authToken from login (admin or operator). Set leadId to a qualified lead first. Creating a bot uses one MonCha slot.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('authToken');",
              "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "List lead bots",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/lead-bots?page=1&pageSize=25" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('counts per status', () => pm.expect(body.counts).to.have.all.keys('pending', 'creating', 'created', 'failed'));",
                  "pm.test('training counts per status', () => pm.expect(body.knowledgeCounts).to.have.all.keys('pending', 'discovering', 'training', 'trained', 'failed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed lead bots",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/lead-bots?status=failed" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only failed bots, each with its error', () => pm.response.json().items.forEach((b) => { pm.expect(b.status).to.eql('failed'); pm.expect(b.error).to.be.a('string'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create lead bot now",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/bot" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created (201) or already there (200)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 201 || body.bot?.status === 'created') {",
                  "  pm.test('bot IDs stored', () => { pm.expect(body.bot.status).to.eql('created'); pm.expect(body.bot.chatbotId).to.be.a('string'); pm.expect(body.bot.monchaTenantId).to.be.a('string'); pm.expect(body.bot.config).to.be.an('object'); });",
                  "  pm.test('tier is a plan tier', () => pm.expect(body.bot.planTier).to.be.oneOf(['starter', 'growth', 'scale']));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get lead bot",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/bot" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const bot = pm.response.json();",
                  "pm.test('belongs to the lead', () => pm.expect(bot.leadId).to.eql(pm.collectionVariables.get('leadId')));",
                  "pm.test('3 tries at most', () => pm.expect(bot.maxAttempts).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get lead (botStatus)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has botStatus', () => pm.expect(pm.response.json()).to.have.property('botStatus'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Train lead bot now (discover + ingest-bulk)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/bot/train" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('submitted (202), polled or already trained (200)', () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "const k = pm.response.json().bot.knowledge;",
                  "pm.test('training submitted or done', () => pm.expect(k.status).to.be.oneOf(['training', 'trained']));",
                  "pm.test('discovered URLs stored', () => pm.expect(k.discoveredUrls).to.be.an('array'));",
                  "pm.test('documents carry only title, url and source_type', () => { pm.expect(k.documents.length).to.be.within(1, 100); k.documents.forEach((d) => pm.expect(d).to.have.all.keys('title', 'url', 'source_type')); });",
                  "pm.test('titles are company - page path', () => k.documents.forEach((d) => pm.expect(d.title).to.match(/ - /)));",
                  "pm.test('training id stored', () => pm.expect(k.trainingId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll training (run again until trained)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/bot/train" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const bot = pm.response.json().bot;",
                  "pm.test('training or trained', () => pm.expect(bot.knowledge.status).to.be.oneOf(['training', 'trained']));",
                  "if (bot.knowledge.status === 'trained') pm.test('error column says success', () => pm.expect(bot.error).to.match(/^success/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bots in training",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/lead-bots?knowledgeStatus=training" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only bots in training', () => pm.response.json().items.forEach((b) => pm.expect(b.knowledge.status).to.eql('training')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry failed bot (409 when not failed)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/leads/{{leadId}}/bot/retry" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('retried (200) or not failed (409)', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));",
                  "if (pm.response.code === 200) pm.test('back to pending', () => pm.expect(pm.response.json().bot.status).to.eql('pending'));",
                  "if (pm.response.code === 409) pm.test('bot_not_failed', () => pm.expect(pm.response.json().error.code).to.eql('bot_not_failed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bot of unknown lead (expect 404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/leads/no-such-lead/bot" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 bot_not_found', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.code).to.eql('bot_not_found'); });"]
              }
            }
          ]
        }
      ]
    }
  ]
}
