# Worker (backend) environment. Copy to apps/worker/.env.
# The only env file the backend reads (worker, local API, Prisma CLI, db scripts). The console uses apps/console/.env.local.
# Neon: dev branch only. Never point at PROD_DB_HOST.

# Database
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_UNPOOLED=
DB_ENV=dev
PROD_DB_HOST=
NEON_BRANCH=dev
DEFAULT_TENANT_ID=tenant_moncha_internal

# Discovery sources
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# LLM (optional Pass 3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
LLM_MAX_CALLS_PER_DAY=500
# Costs page: prices come from OpenRouter's public model list. Override or add models as
# model=input/output in USD per million tokens, comma-separated, e.g. google/gemini-3.5-flash=1.5/9
LLM_PRICE_OVERRIDES=

# Country-wide discovery (pnpm --filter @moncha/worker discover --country ...)
# Every Google Places request counts, including result pages 2-3 and retries.
DISCOVERY_MAX_CALLS_PER_DAY=500
# Daily schedules: calls one scheduled run may spend (3 per search), and how often the worker checks for due schedules.
DISCOVERY_MAX_CALLS_PER_RUN=30
SCHEDULER_TICK_MS=30000

# Test API for Postman (pnpm --filter @moncha/worker api). Set WORKER_API_KEY to require an x-api-key header.
WORKER_API_PORT=4000
WORKER_API_HOST=127.0.0.1
WORKER_API_KEY=

# Console login. Only these emails can sign in, all with the one password below; there is no
# sign-up or password reset. The user row is created as admin on first sign-in. Removing an email
# here ends that user's sessions. Leave either empty and nobody can sign in.
MONCHA_LEAD_ADMIN_USERS=admin@example.com,ops@example.com
MONCHA_LEAD_ADMIN_PASSWORD=

# Worker
WORKER_CONCURRENCY=3
OMIT_CHATBOT_SITES=false

# Website Copy Agent (POST /api/v1/leads/:id/site-snapshots). Without the R2 keys and SITE_PREVIEW_SECRET the
# endpoints answer 503 and the worker does not claim site_snapshot jobs.
# Check with: pnpm --filter @moncha/worker exec tsx src/check-site-agent.ts (prints only whether each key is set).
# R2: Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write on the bucket). The bucket stays private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Brand extraction through OpenRouter (uses OPENROUTER_API_KEY and LLM_MAX_CALLS_PER_DAY above).
SITE_AGENT_MODEL=google/gemini-3.5-flash
SITE_AGENT_TIMEOUT_MS=90000
# Signs preview file links; 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_PREVIEW_SECRET=
# Optional (defaults shown)
SITE_PREVIEW_TTL_SEC=3600
SITE_JOB_TIMEOUT_MS=240000
# Website copies one worker makes at the same time (1 to 4). Each needs a Chromium page, roughly 300-500 MB.
SITE_CONCURRENCY=1
SITE_MAX_ASSETS=400
SITE_MAX_FILE_MB=10
SITE_MAX_TOTAL_MB=80
# Copy automation: after each country crawl, its new qualified leads are queued for website copies.
# Turn it on and set the daily cap in the console (Website copies > Automation). false = never run on this worker.
SITE_AUTO_COPY=true
# One website = one GitHub repo = one Cloudflare Worker = one URL. The site name is the domain with dots as
# dashes (ja.edu.sg -> ja-edu-sg); a newer copy of the same website updates the same repo and Worker.
#
# Older shared copy links (optional): origin of the sites Pages project (apps/worker/sites-pages), used only for
# copies that have no Worker yet. Empty = no fallback link.
SITE_PUBLIC_BASE_URL=https://moncha-sites.pages.dev
# GitHub (optional): every finished copy is pushed to its own private repo {GITHUB_SITES_OWNER}/{site name}
# (created when missing, topics moncha-site + auto-copy/manual-copy). Leave the token empty to skip it.
# Token: GitHub > Settings > Developer settings > Fine-grained tokens, Repository access "All repositories",
# permissions Administration: Read and write (creates the repos) and Contents: Read and write (pushes).
# GITHUB_SITES_OWNER defaults to the owner part of GITHUB_SITES_REPO.
GITHUB_TOKEN=
GITHUB_SITES_OWNER=Thinaakar
GITHUB_SITES_REPO=Thinaakar/moncha-sites
GITHUB_SITES_BRANCH=main
# Cloudflare Workers (optional): every finished copy is deployed as its own Worker at
# https://{site name}.{workers.dev subdomain}.workers.dev. Leave the token empty to skip it.
# Token: Cloudflare > My Profile > API Tokens > Create token, permission Account > Workers Scripts: Edit.
# CLOUDFLARE_ACCOUNT_ID defaults to R2_ACCOUNT_ID; the subdomain is read from the account when empty.
# The plan limits Workers per account (100 free, 500 paid). New site Workers stop at CLOUDFLARE_WORKERS_LIMIT
# (default 100) with "Worker limit reached"; set it to 500 after upgrading to Workers Paid.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=
CLOUDFLARE_WORKERS_LIMIT=

# MonCha internal lead API (internal-lead-agent.md): demo bots for leads. Key = the secret saved in MonCha Admin
# (API - vendor and Internal lead agent enabled). Server-side only: never put it in a copied website, the widget,
# a URL or a log. A UAT key does not work in production. Empty base URL = UAT; production is
# https://api.moncha.co/vendor/internal/v1 and must be set on purpose.
# Check with: pnpm --filter @moncha/worker exec tsx src/check-moncha-internal.ts (calls GET /slots, prints no secret).
# With a key set, every lead gets a bot (POST /bots, tier with the most free slots), trained on its website
# (knowledge/discover, ingest-bulk, training status), before its website is copied; a bot or training that fails 3
# tries fails that lead's copy and the worker moves on. Without a key, copies run without bots.
# With a key set, each copied website also gets its chatbot before the GitHub push: the widget primaryColor is set
# from the site's brand colour (GET then PUT /bots/{id}/widget) and the /install embed is added to index.html.
# Live websites without the chatbot are republished with it once their bot is trained.
# Bots for websites copied earlier: pnpm --filter @moncha/worker bots:backfill -- --dry-run (then without --dry-run).
MONCHA_INTERNAL_BASE_URL=https://api.dev-moncha.com/vendor/internal/v1
MONCHA_INTERNAL_KEY=
