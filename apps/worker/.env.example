# Worker (backend) environment. Copy to apps/worker/.env.
# The only env file the backend reads (worker, local API, Prisma CLI, db scripts). The console uses apps/console/.env.local.
# Neon: dev branch only. Never point at PROD_DB_HOST.

# Database
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_UNPOOLED=
DB_ENV=dev
PROD_DB_HOST=
NEON_BRANCH=dev
DEFAULT_TENANT_ID=tenant_moncha_internal

# Discovery sources
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# LLM (optional Pass 3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
LLM_MAX_CALLS_PER_DAY=500

# Country-wide discovery (pnpm --filter @moncha/worker discover --country ...)
# Every Google Places request counts, including result pages 2-3 and retries.
DISCOVERY_MAX_CALLS_PER_DAY=500
# Daily schedules: calls one scheduled run may spend (3 per search), and how often the worker checks for due schedules.
DISCOVERY_MAX_CALLS_PER_RUN=30
SCHEDULER_TICK_MS=30000

# Test API for Postman (pnpm --filter @moncha/worker api). Set WORKER_API_KEY to require an x-api-key header.
WORKER_API_PORT=4000
WORKER_API_HOST=127.0.0.1
WORKER_API_KEY=

# Password reset email (Resend). On Cloudflare set these as secrets/vars too.
# RESET_PASSWORD_URL is the console page that reads ?token= and POSTs /api/v1/auth/reset-password.
RESEND_API_KEY=
EMAIL_FROM=MonCha <onboarding@resend.dev>
RESET_PASSWORD_URL=

# Worker
WORKER_CONCURRENCY=3
OMIT_CHATBOT_SITES=false

# Website Copy Agent (POST /api/v1/leads/:id/site-snapshots). Without the R2 keys and SITE_PREVIEW_SECRET the
# endpoints answer 503 and the worker does not claim site_snapshot jobs.
# Check with: pnpm --filter @moncha/worker exec tsx src/check-site-agent.ts (prints only whether each key is set).
# R2: Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write on the bucket). The bucket stays private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Brand extraction through OpenRouter (uses OPENROUTER_API_KEY and LLM_MAX_CALLS_PER_DAY above).
SITE_AGENT_MODEL=google/gemini-3.5-flash
SITE_AGENT_TIMEOUT_MS=90000
# Signs preview file links; 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_PREVIEW_SECRET=
# Optional (defaults shown)
SITE_PREVIEW_TTL_SEC=3600
SITE_JOB_TIMEOUT_MS=240000
SITE_MAX_ASSETS=400
SITE_MAX_FILE_MB=10
SITE_MAX_TOTAL_MB=80
# Copy automation: after each country crawl, its new qualified leads are queued for website copies.
# Turn it on and set the daily cap in the console (Website copies > Automation). false = never run on this worker.
SITE_AUTO_COPY=true
# GitHub push (optional): every finished copy's HTML, CSS, JS, brand.json and manifest.json is committed to
# sites/{domain}/{copyId}/ in this repo. Images, fonts and screenshots stay in R2 only. Leave the token or repo
# empty to skip the push. Token: GitHub > Settings > Developer settings > Fine-grained tokens, limited to this
# one repo with Contents: Read and write. The repo needs at least one commit (e.g. a README) on the branch.
GITHUB_TOKEN=
GITHUB_SITES_REPO=Thinaakar/moncha-sites
GITHUB_SITES_BRANCH=main
